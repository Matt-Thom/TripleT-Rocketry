# Required. The app refuses to start without it — there is no built-in default.
TRIPLET_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/triplet

# Required to run the test suite, which creates and DROPS every table in the
# target database. Must name a disposable database containing "test".
TRIPLET_TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/triplet_test

TRIPLET_PROJECT_ID=PROJ-075AA139
TRIPLET_ENVIRONMENT=development
